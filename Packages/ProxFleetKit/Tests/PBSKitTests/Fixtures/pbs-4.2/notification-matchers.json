{
  "data": [
    {
      "comment": "Route everything but successful prune job notifications to mail-to-root",
      "invert-match": true,
      "match-field": [
        "exact:type=prune"
      ],
      "match-severity": [
        "info"
      ],
      "mode": "all",
      "name": "default-matcher",
      "origin": "builtin",
      "target": [
        "mail-to-root"
      ]
    }
  ]
}

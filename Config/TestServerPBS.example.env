# Copy to TestServerPBS.local.env (ignored by git) and fill in a disposable Proxmox Backup Server.
# Never use a production server: the seed script and the live tests create and delete datastores, users and jobs.
# Used by scripts/run-simulator.sh --test-pbs (DEBUG builds only), scripts/seed-backup-server.py and the live tests.

ADDRESS=192.168.1.60:8007
USER=root
REALM=pam
PASSWORD=change-me
# Optional. SHA-256 fingerprint of the server certificate, to skip the trust prompt.
FINGERPRINT=
# scripts/seed-backup-server.py appends the generated users, passwords and the API token below.

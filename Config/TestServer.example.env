# Copy to TestServer.local.env (ignored by git) and fill in a test server.
# Use a dedicated test user, never credentials of a production server.
# Used by scripts/run-simulator.sh --test, DEBUG builds only.

ADDRESS=192.168.1.50:8006
USER=tester
REALM=pve
PASSWORD=change-me
# Optional. SHA-256 fingerprint of the server certificate, to skip the trust prompt.
FINGERPRINT=

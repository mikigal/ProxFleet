<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Proxmox servers usually have self-signed certificates and are reached by user-entered host names.
	ATS only lets the app evaluate such certificates itself when arbitrary loads are allowed.
	The app still connects over HTTPS only, and accepts a certificate only when the system trusts it
	or the user confirmed its SHA-256 fingerprint (see URLSessionTransport).
	-->
	<!-- iPhone screens stay portrait; the full-screen VM console unlocks landscape (see OrientationLock). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Mice and trackpads arrive as pointer events with buttons and scrolling, which the VM console passes on. -->
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
